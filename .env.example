# BHD Cars — local/staging variable names only. Never put real secrets here.
# Copy to .env.local for development. Values below are intentional dummies.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3010
NEXT_PUBLIC_DEFAULT_MARKET=om
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Session signing (BHD-004). Dummy only — rotate in every real environment.
AUTH_SECRET=dev-only-change-me-32chars-minimum!!

# BHD Identity / SSO (disabled until configured; BHD-004)
BHD_IDENTITY_ISSUER=https://id.example.test
BHD_OAUTH_CLIENT_ID=bhd-cars-local
BHD_OAUTH_CLIENT_SECRET=dev-only-oauth-secret
BHD_OAUTH_REDIRECT_URI=http://127.0.0.1:3010/api/auth/bhd/callback

# Disposable PostgreSQL for integration tests / later Prisma (BHD-003)
# Use a dedicated test DB only — never production.
DATABASE_URL=postgresql://bhd:bhd@127.0.0.1:5432/bhd_cars_test

# Object storage placeholders (BHD-006)
STORAGE_BUCKET=bhd-cars-dev
STORAGE_REGION=me-south-1
STORAGE_ENDPOINT=http://127.0.0.1:9000

# Observability placeholders (no real keys)
LOG_LEVEL=info
SENTRY_DSN=

# Playwright / CI helpers
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_PORT=3010
