# BHD Cars — local/staging variable names only. Never put real secrets here.
# Copy to .env.local for development.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3010
NEXT_PUBLIC_DEFAULT_MARKET=om
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Session signing — required for OAuth callback/rebind. Rotate in every real environment.
AUTH_SECRET=

# BHD Identity / SSO — register client at https://id.bhd-om.com/admin#connect
BHD_IDENTITY_ISSUER=https://id.bhd-om.com
BHD_OAUTH_CLIENT_ID=bhd-cars
BHD_OAUTH_CLIENT_SECRET=
BHD_OAUTH_REDIRECT_URI=https://cars.bhd-om.com/api/auth/bhd/callback

# Optional local override while developing against production identity:
# BHD_OAUTH_REDIRECT_URI=http://127.0.0.1:3010/api/auth/bhd/callback
